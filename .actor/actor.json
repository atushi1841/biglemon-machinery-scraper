{
  "actorSpecification": 1,
  "name": "biglemon-machinery-scraper",
  "title": "BIGLEMON Japan Used Construction Machinery — Cranes, Forklifts, Trucks",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "readme": "./README.md",
  "input": "./INPUT_SCHEMA.json",
  "outputSchema": {
    "actorOutputSchemaVersion": 1,
    "title": "BIGLEMON Used Machinery",
    "description": "Used construction machinery, forklifts, and trucks from biglemon.kenkey.jp",
    "type": "object",
    "properties": {
      "itemId": {
        "title": "Item ID",
        "type": "string",
        "description": "Item ID from BIGLEMON",
        "template": "{{itemId}}"
      },
      "title": {
        "title": "Title",
        "type": "string",
        "description": "Combined maker + model",
        "template": "{{title}}"
      },
      "maker": {
        "title": "Maker",
        "type": "string",
        "description": "Manufacturer name",
        "template": "{{maker}}"
      },
      "model": {
        "title": "Model",
        "type": "string",
        "description": "Machine model designation",
        "template": "{{model}}"
      },
      "year": {
        "title": "Year",
        "type": "string",
        "description": "Manufacturing year (4-digit)",
        "template": "{{year}}"
      },
      "price": {
        "title": "Price (JPY)",
        "type": "string",
        "description": "Total price in yen",
        "template": "{{price}}"
      },
      "currency": {
        "title": "Currency",
        "type": "string",
        "description": "JPY",
        "template": "{{currency}}"
      },
      "category": {
        "title": "Category",
        "type": "string",
        "description": "Machine category",
        "template": "{{category}}"
      },
      "imageUrl": {
        "title": "Image URL",
        "type": "string",
        "description": "Machine image URL",
        "template": "{{imageUrl}}"
      },
      "detailUrl": {
        "title": "Detail URL",
        "type": "string",
        "description": "Listing page URL",
        "template": "{{detailUrl}}"
      },
      "listedAt": {
        "title": "Listed At",
        "type": "string",
        "description": "Publish date (if available)",
        "template": "{{listedAt}}"
      },
      "source": {
        "title": "Source",
        "type": "string",
        "description": "biglemon",
        "template": "{{source}}"
      },
      "scrapedAt": {
        "title": "Scraped At",
        "type": "string",
        "description": "Scrape timestamp",
        "template": "{{scrapedAt}}"
      }
    },
    "required": [
      "itemId",
      "title",
      "price"
    ]
  }
}
